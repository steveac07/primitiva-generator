{
  "name": "primitiva-generator",
  "version": "1.0.0",
  "description": "Generador de combinaciones para La Primitiva con filtros anti-patrón (TypeScript)",
  "scripts": {
    "gen": "tsx src/cli.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsx scripts/build-web.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "primitiva": "./src/cli.ts"
  }
}
